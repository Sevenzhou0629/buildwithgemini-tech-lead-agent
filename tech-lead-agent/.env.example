# Engineering Tech Lead Agent Configuration

# OpenAI API Settings (or compatible proxy like Azure, Ollama, vLLM, LiteLLM)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Database
DATABASE_URL=sqlite:///./tech_lead.db

# Security & Safety
ALLOW_EXTERNAL_WRITES=false

# MCP Integration Modes (mock | stdio | sse)
MCP_MODE=mock

# Config paths or connections for real MCP servers (when MCP_MODE=stdio or sse)
# JIRA_MCP_COMMAND=npx
# JIRA_MCP_ARGS=-y @modelcontextprotocol/server-jira
# GITHUB_MCP_COMMAND=npx
# GITHUB_MCP_ARGS=-y @modelcontextprotocol/server-github
# SLACK_MCP_COMMAND=npx
# SLACK_MCP_ARGS=-y @modelcontextprotocol/server-slack
# CONFLUENCE_MCP_COMMAND=npx
# CONFLUENCE_MCP_ARGS=-y @modelcontextprotocol/server-confluence
